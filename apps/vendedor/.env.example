# Copiar a .env.local y completar con los datos del proyecto Supabase
# (Supabase Dashboard > Project Settings > API). Es el mismo proyecto que usa
# apps/admin — los mismos tres valores sirven acá.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo del lado del servidor (nunca llega al navegador): la necesita el login
# por PIN para derivar la contraseña real y para contar los intentos fallidos.
SUPABASE_SERVICE_ROLE_KEY=

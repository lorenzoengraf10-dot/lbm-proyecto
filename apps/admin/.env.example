# Copiar a .env.local y completar con los datos del proyecto Supabase
# (Supabase Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: solo se usa del lado del servidor, para dar de alta las
# cuentas de los vendedores (crear un usuario en Auth requiere permisos de
# administrador). Nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Datos del proyecto Supabase (Project Settings > API).
# Copiar a .env y completar. Nunca commitear el archivo .env real.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key: solo para correr los scripts de scripts/ desde una
# máquina de confianza (bypasea RLS). Nunca usar esta key en las apps
# admin/vendedor ni exponerla en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
